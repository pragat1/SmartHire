{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://aivpvtpfydlsnyquzrhc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "smarthire-ai-mcp",
      "version": "0.1.0",
      "title": "SmartHire AI MCP"
    },
    "tools": [
      {
        "name": "score_resume",
        "title": "Score resume",
        "description": "Compute a lightweight ATS-style score (0–100) for a resume, plus a breakdown across skills, experience, projects, and summary depth.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "resume": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "experience": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "Structured resume data to evaluate."
            }
          },
          "required": [
            "resume"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "rewrite_bullet",
        "title": "Rewrite resume bullet",
        "description": "Rewrite a vague resume bullet point into a quantified, ATS-friendly line in the requested tone.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 3,
              "description": "The original bullet or description to rewrite."
            },
            "tone": {
              "default": "professional",
              "description": "Rewrite style.",
              "type": "string",
              "enum": [
                "professional",
                "technical",
                "impact"
              ]
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "suggest_projects",
        "title": "Suggest resume projects",
        "description": "Suggest 3–5 buildable portfolio projects that strengthen a resume for a target role, based on the user's current skills.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Skills already on the resume."
            },
            "targetRole": {
              "type": "string",
              "description": "Target job role, e.g. 'Frontend Developer'."
            }
          },
          "required": [
            "skills",
            "targetRole"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
